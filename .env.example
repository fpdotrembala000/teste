ANTHROPIC_API_KEY=coloque_sua_chave_aqui
# Opcional. Se nao definido, o app tenta automaticamente:
# claude-haiku-4-5 -> claude-sonnet-4-5 -> claude-3-5-haiku-latest -> claude-3-5-sonnet-latest
# Use claude-haiku-4-5 (mais barato/rapido) ou claude-sonnet-4-5 (mais inteligente).
ANTHROPIC_MODEL=claude-haiku-4-5

SPOTIFY_CLIENT_ID=coloque_seu_client_id_aqui
SPOTIFY_CLIENT_SECRET=coloque_seu_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Cookie signing secret (random string, recommended for production)
SESSION_SECRET=troque_por_uma_string_aleatoria_longa
